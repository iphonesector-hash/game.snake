<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>LoveHub Games</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: white;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hub {
      text-align: center;
      padding: 20px;
    }
    h1 {
      font-size: 2.2rem;
      margin-bottom: 8px;
      background: linear-gradient(90deg, #60a5fa, #ec4899);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .subtitle {
      opacity: 0.7;
      margin-bottom: 40px;
      font-size: 1rem;
    }
    .game-card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 28px;
      padding: 32px 28px;
      max-width: 340px;
      margin: 0 auto;
      cursor: pointer;
      transition: all 0.35s ease;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }
    .game-card:active {
      transform: scale(0.97);
    }
    .game-card img {
      width: 140px;
      height: 140px;
      object-fit: contain;
      margin-bottom: 16px;
      filter: drop-shadow(0 10px 25px rgba(236, 72, 153, 0.4));
    }
    .game-card h2 {
      font-size: 1.5rem;
      margin-bottom: 8px;
    }
    .game-card p {
      opacity: 0.75;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    #game-container {
      display: none;
      width: 100%;
      height: 100vh;
      position: fixed;
      top: 0;
      left: 0;
      background: #0f172a;
    }
  </style>
</head>
<body>
  <div class="hub" id="hub">
    <h1>LoveHub Games</h1>
    <p class="subtitle">تجربه پرمیوم • Apple Arcade Style</p>

    <div class="game-card" onclick="startSnake()">
      <!-- لوگو را بعداً اضافه کن یا موقتاً حذف کن -->
      <div style="font-size: 80px; margin-bottom: 12px;">🐍</div>
      <h2>LoveHub Snake</h2>
      <p>مار پرمیوم با پیشرفت، دستاوردها و مولتی‌پلیر محلی</p>
    </div>
  </div>

  <div id="game-container"></div>

  <script type="module">
    import LoveHubSnake from './games/snake/snake.js';

    window.startSnake = () => {
      const hub = document.getElementById('hub');
      const container = document.getElementById('game-container');
      hub.style.display = 'none';
      container.style.display = 'block';

      const game = new LoveHubSnake();
      game.init(container);
      game.start();
    };
  </script>
</body>
</html>