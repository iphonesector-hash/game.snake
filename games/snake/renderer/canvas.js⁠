export class SnakeRenderer {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.gridSize = 20;
  }

  clear() {
    this.ctx.fillStyle = '#0f172a';
    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

    // خطوط شبکه خیلی کمرنگ
    this.ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    this.ctx.lineWidth = 1;
    for (let i = 0; i <= 25; i++) {
      this.ctx.beginPath();
      this.ctx.moveTo(i * this.gridSize, 0);
      this.ctx.lineTo(i * this.gridSize, this.canvas.height);
      this.ctx.stroke();
      this.ctx.beginPath();
      this.ctx.moveTo(0, i * this.gridSize);
      this.ctx.lineTo(this.canvas.width, i * this.gridSize);
      this.ctx.stroke();
    }
  }

  drawSnake(snake) {
    snake.forEach((segment, index) => {
      const x = segment.x * this.gridSize;
      const y = segment.y * this.gridSize;

      this.ctx.shadowColor = index === 0 ? '#60a5fa' : '#3b82f6';
      this.ctx.shadowBlur = index === 0 ? 18 : 8;

      this.ctx.fillStyle = index === 0 ? '#93c5fd' : '#60a5fa';
      this.ctx.beginPath();
      this.ctx.roundRect(x + 2, y + 2, this.gridSize - 4, this.gridSize - 4, 6);
      this.ctx.fill();

      this.ctx.shadowBlur = 0;
    });
  }

  drawFood(food) {
    const x = food.x * this.gridSize + this.gridSize / 2;
    const y = food.y * this.gridSize + this.gridSize / 2;

    this.ctx.shadowColor = '#f472b6';
    this.ctx.shadowBlur = 22;

    this.ctx.fillStyle = '#ec4899';
    this.ctx.beginPath();
    this.ctx.arc(x, y, this.gridSize / 2 - 3, 0, Math.PI * 2);
    this.ctx.fill();

    this.ctx.shadowBlur = 0;
  }

  drawUI(score, gameOver) {
    this.ctx.fillStyle = 'rgba(255,255,255,0.9)';
    this.ctx.font = 'bold 22px -apple-system, system-ui';
    this.ctx.fillText(`امتیاز: ${score}`, 16, 36);

    if (gameOver) {
      this.ctx.fillStyle = 'rgba(0,0,0,0.65)';
      this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

      this.ctx.fillStyle = '#fff';
      this.ctx.font = 'bold 36px -apple-system, system-ui';
      this.ctx.textAlign = 'center';
      this.ctx.fillText('بازی تمام شد', this.canvas.width / 2, this.canvas.height / 2 - 20);
      this.ctx.font = '20px -apple-system, system-ui';
      this.ctx.fillText('برای شروع دوباره R را بزنید', this.canvas.width / 2, this.canvas.height / 2 + 25);
      this.ctx.textAlign = 'left';
    }
  }
}

export default SnakeRenderer;
